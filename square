#include <Servo.h>

Servo leftServo;
Servo rightServo;

void setup() {
  leftServo.attach(9);
  rightServo.attach(10);
}


void loop() {
  // Move forward
  leftServo.write(180);
  rightServo.write(0);
  delay(2000);

  // Stop
  leftServo.write(90);
  rightServo.write(90);
  delay(1000);

  // Move backward
  leftServo.write(0);
  rightServo.write(180);
  delay(2000);

  // Stop
  leftServo.write(90);
  rightServo.write(90);
  delay(1000);

  // Turn left
  leftServo.write(180);
  rightServo.write(180);
  delay(1000);

  // Turn right
  leftServo.write(180);
  rightServo.write(180);
  delay(1000);

  // Stop
  leftServo.write(90);
  rightServo.write(90);
  delay(1000);
}
